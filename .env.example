# Variabili d'ambiente per la Cloudflare Pages Function functions/api/recensioni.ts
# Da configurare su Cloudflare Pages: Settings → Environment variables (non in questo file,
# che serve solo da promemoria — .env* è ignorato da git).

# API key di Resend (https://resend.com), come "secret".
RESEND_API_KEY=

# Indirizzo a cui inviare la notifica di nuova recensione. Opzionale: se assente
# viene usato alessandroformica6@gmail.com come da functions/api/recensioni.ts.
NOTIFY_EMAIL=alessandroformica6@gmail.com

# Inoltre serve un binding KV (non una env var):
# Settings → Functions → KV namespace bindings → variable name "RECENSIONI_KV"
