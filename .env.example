# Variabili d'ambiente per il Worker worker/index.ts (config in wrangler.jsonc).
# Questo file serve solo da promemoria — .env* è ignorato da git, non viene letto
# né da wrangler né dal build SvelteKit.

# API key di Resend (https://resend.com). Va impostata come SECRET, mai come var
# in chiaro: dashboard Cloudflare → Workers & Pages → formikadesk-site →
# Settings → Variables and Secrets → Secret. Non va mai messa in wrangler.jsonc
# perché quel file è versionato su Git.
RESEND_API_KEY=

# Indirizzo a cui inviare la notifica di nuova recensione. Già dichiarata come
# "vars" in wrangler.jsonc (non sensibile, ok tenerla in chiaro nel repo):
# se la cambi, aggiorna anche wrangler.jsonc.
NOTIFY_EMAIL=alessandroformica6@gmail.com

# Inoltre serve il binding KV RECENSIONI_KV, già dichiarato in wrangler.jsonc
# (kv_namespaces), namespace creato con:
#   npx wrangler kv namespace create RECENSIONI_KV
